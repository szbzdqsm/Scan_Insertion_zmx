{
  "name": "ScanInsertion official tools (Ubuntu 24 / Python 3.12)",
  "build": {"dockerfile": "Dockerfile", "context": ".."},
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/scan-agent-dev,type=bind",
  "workspaceFolder": "/workspaces/scan-agent-dev",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-python.debugpy", "charliermarsh.ruff", "mshr-h.veriloghdl"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python-envs.workspaceSearchPaths": []
      }
    }
  }
}
